{
  "name": "gladys-pushsafer",
  "version": "0.1.0",
  "private": true,
  "description": "External Gladys Assistant integration that sends Gladys notifications as Pushsafer pushes (iOS, Android, Windows, browsers), with scene triggers, a scene action and dashboard widgets.",
  "homepage": "https://github.com/William-De71/gladys-pushsafer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-pushsafer.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "pushsafer",
    "push",
    "notifications"
  ]
}
